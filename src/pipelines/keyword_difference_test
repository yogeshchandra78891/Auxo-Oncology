import pandas as pd


# ============================================================
# FILE PATHS
# ============================================================

ICD_CSV = "data/ICD_with_categories_updated.csv"
ONCOLOGY_CSV = "data/Indication_Oncology(in).csv"

OUTPUT_CSV = "data/ICD_with_categories_updated_difference.csv"


# ============================================================
# HELPER FUNCTIONS
# ============================================================

def normalize(text):
    """
    Normalize text for case-insensitive comparison.
    """
    if pd.isna(text):
        return ""

    return str(text).strip().casefold()


def parse_abbreviations(value):
    """
    Convert abbreviations into a list.

    Supports:
    - A | B | C
    - A, B, C
    """

    if pd.isna(value):
        return []

    value = str(value).strip()

    if not value:
        return []

    # Support both separators
    value = value.replace("|", ",")

    return [
        item.strip()
        for item in value.split(",")
        if item.strip()
    ]


def create_match_key(description_2, description_3):
    """
    Create a matching key using BOTH description_2
    and description_3.
    """

    return (
        normalize(description_2),
        normalize(description_3)
    )


# ============================================================
# READ ICD CSV
# ============================================================

print("\nReading ICD_with_categories_updated.csv...")

icd_df = pd.read_csv(
    ICD_CSV,
    encoding="utf-8-sig"
)

print(f"ICD rows loaded: {len(icd_df)}")


# ============================================================
# READ ONCOLOGY CSV
# ============================================================

print("Reading Indication_Oncology(in).csv...")

oncology_df = pd.read_csv(
    ONCOLOGY_CSV,
    encoding="utf-8-sig"
)

print(f"Oncology rows loaded: {len(oncology_df)}")


# ============================================================
# ASK USER FOR DIFFERENCE TYPE
# ============================================================

print("\n==============================================")
print("       ABBREVIATION DIFFERENCE GENERATOR")
print("==============================================")

print("\nMatching Oncology rows using:")
print("description_2 + description_3")
print("(both case-insensitive)")

print("\nSelect the difference you want:\n")

print("1. Oncology - Final")
print("   Oncology abbreviations NOT in ICD Final Abbreviations")

print("\n2. Final - Oncology")
print("   ICD Final Abbreviations NOT in Oncology")

print("\n==============================================")

scenario = input(
    "\nEnter your choice (1 or 2): "
).strip()


# ============================================================
# VALIDATE SCENARIO
# ============================================================

if scenario not in ["1", "2"]:

    print("\nInvalid choice. Please enter 1 or 2.")
    exit()


# ============================================================
# CREATE ONCOLOGY MATCH MAP
# ============================================================

oncology_match_map = {}

for _, row in oncology_df.iterrows():

    description_2 = row["description_2"]
    description_3 = row["description_3"]

    # Skip rows where both descriptions are empty
    if pd.isna(description_2) and pd.isna(description_3):
        continue

    # --------------------------------------------------------
    # MATCH USING description_2 + description_3
    # --------------------------------------------------------

    match_key = create_match_key(
        description_2,
        description_3
    )

    oncology_abbreviations = parse_abbreviations(
        row["abbreviations"]
    )

    oncology_match_map[match_key] = oncology_abbreviations


# ============================================================
# CREATE NEW COLUMNS
# ============================================================

oncology_abbreviations_column = []
difference_column = []


# ============================================================
# PROCESS EACH ICD ROW
# ============================================================

matched_count = 0
unmatched_count = 0


for _, row in icd_df.iterrows():

    description_2 = row["description_2"]
    description_3 = row["description_3"]


    # --------------------------------------------------------
    # CREATE MATCH KEY
    # --------------------------------------------------------

    match_key = create_match_key(
        description_2,
        description_3
    )


    # --------------------------------------------------------
    # FIND EXACT MATCH IN ONCOLOGY
    # --------------------------------------------------------

    oncology_abbreviations = oncology_match_map.get(
        match_key
    )


    # --------------------------------------------------------
    # NO MATCH
    # --------------------------------------------------------

    if oncology_abbreviations is None:

        oncology_abbreviations_column.append("")
        difference_column.append("")

        unmatched_count += 1
        continue


    matched_count += 1


    # --------------------------------------------------------
    # GET ICD FINAL ABBREVIATIONS
    # --------------------------------------------------------

    final_abbreviations = parse_abbreviations(
        row["final abbreviations"]
    )


    # --------------------------------------------------------
    # NORMALIZE ABBREVIATIONS
    # --------------------------------------------------------

    oncology_normalized = {
        normalize(abbr)
        for abbr in oncology_abbreviations
    }

    final_normalized = {
        normalize(abbr)
        for abbr in final_abbreviations
    }


    # ========================================================
    # SCENARIO 1
    # ONCOLOGY - FINAL
    # ========================================================

    if scenario == "1":

        difference = [
            abbr
            for abbr in oncology_abbreviations
            if normalize(abbr) not in final_normalized
        ]


    # ========================================================
    # SCENARIO 2
    # FINAL - ONCOLOGY
    # ========================================================

    else:

        difference = [
            abbr
            for abbr in final_abbreviations
            if normalize(abbr) not in oncology_normalized
        ]


    # --------------------------------------------------------
    # APPEND VALUES
    # --------------------------------------------------------

    oncology_abbreviations_column.append(
        " | ".join(oncology_abbreviations)
    )

    difference_column.append(
        " | ".join(difference)
    )


# ============================================================
# APPEND NEW COLUMNS TO ICD DATAFRAME
# ============================================================

icd_df["Oncology Abbreviations"] = (
    oncology_abbreviations_column
)

icd_df["Difference"] = difference_column


# ============================================================
# SAVE OUTPUT
# ============================================================

icd_df.to_csv(
    OUTPUT_CSV,
    index=False,
    encoding="utf-8-sig"
)


# ============================================================
# SUMMARY
# ============================================================

print("\n==============================================")
print("             PROCESS COMPLETED")
print("==============================================")

if scenario == "1":

    print("Difference type:")
    print("Oncology - Final")

else:

    print("Difference type:")
    print("Final - Oncology")


print("\nMatching fields:")
print("description_2 + description_3")
print("(case-insensitive)")


print(f"\nMatched ICD rows: {matched_count}")
print(f"Unmatched ICD rows: {unmatched_count}")


print("\nColumns appended:")
print("1. Oncology Abbreviations")
print("2. Difference")


print("\nOutput file:")
print(OUTPUT_CSV)

print("==============================================\n")